# HiBid Scraper Configuration
# Copy this file to .env and update with your values

# Required: Your zip code for location-based search
ZIP_CODE=78414

# Search radius in miles. The pipeline's question is "within 50 km", and
# HiBid's radius is whole miles — 31 mi is 49.9 km, the closest it can be
# asked. HiBid honours it loosely and publishes no distance of its own, so the
# exact cutoff is applied in silver_enhanced.auction_schedule against postal
# centroids. Ask narrow here, filter exactly there.
RADIUS_MILES=31

# How far ahead auction discovery pages before it stops. Only auctions closing
# in a day or two are acted on; the rest is headroom so a missed run can catch
# up.
DISCOVERY_HORIZON_DAYS=14

# Scope a lot scrape to one auction's catalogue instead of a radius search.
# Normally left empty — scrape_closing_auctions sets it per auction.
AUCTION_ID=

# Test mode: limit to 20 items for testing (true/false)
TEST_MODE=false

# Database settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bargin_sort
DB_PASSWORD=
DB_NAME=bargin_sort

# FlareSolverr endpoint — used as a fallback when Cloudflare answers a direct
# request with 403. Use http://flaresolverr:8191/v1 from inside Docker.
# Leave empty to disable the fallback and always fetch directly.
FLARESOLVERR_URL=http://localhost:8191/v1
FLARESOLVERR_TIMEOUT_MS=60000

# dbt project location. Leave empty to auto-detect (beside this module in the
# container, one level up in a checkout).
DBT_PROJECT_DIR=

# Rate limiting: delay between requests in seconds (min, max)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Search categories (comma-separated, leave empty for all open lots)
# Examples: cars,trucks,coins---currency,antiques
SEARCH_CATEGORIES=
