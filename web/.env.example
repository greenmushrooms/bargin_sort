# Copy to web/.env and fill in the password.
#
# These are the scraper's own variable names on purpose — config.Config reads
# them, and the refresh path uses that same class, so one file configures both
# the site's reads and the fetch behind the Refresh button.

# hub_db as seen from the host. Inside project-hub-network the host is `hub_db`
# and the port is 5432; from a `uv run` on the machine it is localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bargin_sort
DB_USER=user__bargin_sort
# Prefect Secret block `bargin-sort--database-password`. Read it with:
#   prefect block inspect secret/bargin-sort--database-password
DB_PASSWORD=

# The refresh button drives a real browser through FlareSolverr for HiBid.
# Published on the host as 8191; `http://flaresolverr:8191/v1` from inside the
# docker network. Leaving it empty makes refresh try a direct request, which
# Cloudflare will usually 403.
FLARESOLVERR_URL=http://localhost:8191/v1
FLARESOLVERR_TIMEOUT_MS=60000

# Route FlareSolverr's browser through the scraper VPN. Empty is correct for a
# handful of manual refreshes; set it if you start refreshing in volume.
# FLARESOLVERR_PROXY=http://gluetun-scraper:8888

# Recorded on the one-row scrape_runs entry each refresh writes. Cosmetic —
# it lands in search_zip_code, which nothing downstream reads for a lot page.
ZIP_CODE=M8W3B7

# --- site only ---
# 127.0.0.1 keeps it to this machine; 0.0.0.0 exposes it to the LAN, which is
# how you reach it from a phone. There is no authentication on this site and
# the refresh button makes outbound fetches, so 0.0.0.0 is a trusted-network
# setting, not an internet-facing one.
WEB_HOST=0.0.0.0
WEB_PORT=7780
WEB_SEARCH_LIMIT=200
